# Copy to .env and edit. Every value here has a default; this file only overrides them.

# Folder of documents, source code and .sql files to answer from
DOCQA_DOCS_DIR=./my_files
# Where the vector DB and the record-manager SQLite file are kept
DOCQA_DATA_DIR=./data

# Chat model provider: ollama (default, local) | openai | anthropic | google
DOCQA_LLM_PROVIDER=ollama
# qwen2.5-coder:7b is better than llama3.1 at SQL and code questions
DOCQA_LLM_MODEL=llama3.1

# Embedding provider: ollama (default, local) | openai | google
DOCQA_EMBED_PROVIDER=ollama
DOCQA_EMBED_MODEL=nomic-embed-text

# Only needed when Ollama is not on localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Cloud keys (only for the provider you pick)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Chunking and retrieval
DOCQA_CHUNK_SIZE=800
DOCQA_CHUNK_OVERLAP=150
DOCQA_TOP_K=4

# Ollama context window in tokens (Ollama's own default is small and trims silently)
DOCQA_NUM_CTX=8192

# Set to 1 to parse PDFs/DOCX with Docling (better tables/scans; pip install -e ".[docling]")
DOCQA_USE_DOCLING=0

# --- Code ---
# Set to 0 to index documents only
DOCQA_INCLUDE_CODE=1
DOCQA_CODE_CHUNK_SIZE=1500
DOCQA_CODE_CHUNK_OVERLAP=150
# Code and text files larger than this are skipped (minified bundles, data dumps)
DOCQA_MAX_FILE_KB=1024

# --- SQL ---
# Optional database, opened read-only. Use a read-only database user for anything but SQLite/Postgres/MySQL.
# DOCQA_DATABASE_URL=sqlite:///my_company.db
# DOCQA_DATABASE_URL=postgresql+psycopg://readonly_user:password@localhost/sales
# Dialect to write SQL in when no database is connected (postgres, mysql, tsql, snowflake, bigquery, oracle, sqlite)
DOCQA_SQL_DIALECT=postgres
# Only describe these tables to the model (comma-separated; empty = all)
# DOCQA_SQL_TABLES=orders,customers
DOCQA_SQL_MAX_ATTEMPTS=3
DOCQA_SQL_MAX_ROWS=50
# Map the question to tables and business rules before writing SQL (one extra model call)
DOCQA_SQL_SCHEMA_LINKING=1
